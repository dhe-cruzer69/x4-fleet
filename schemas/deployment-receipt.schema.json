{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dhe-cruzer69/x4-fleet/schemas/deployment-receipt.schema.json",
  "title": "X4 BEASTMODE Deployment Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deployment_id",
    "release_run_id",
    "target",
    "status",
    "requested_digest",
    "observed_digest",
    "source_commit",
    "started_at_utc",
    "finished_at_utc",
    "readiness",
    "rollback"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "deployment_id": { "type": "string", "minLength": 1 },
    "release_run_id": { "type": "integer", "minimum": 1 },
    "target": { "type": "string", "minLength": 1 },
    "status": { "enum": ["blocked", "deploying", "succeeded", "failed"] },
    "requested_digest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "observed_digest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "source_commit": { "type": ["string", "null"], "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$" },
    "started_at_utc": { "type": "string", "format": "date-time" },
    "finished_at_utc": { "type": ["string", "null"], "format": "date-time" },
    "readiness": { "type": ["object", "null"] },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "status"],
      "properties": {
        "attempted": { "type": "boolean" },
        "status": { "enum": ["not_attempted", "attempted", "verified", "failed"] },
        "observed_digest": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "error": { "type": ["string", "null"], "maxLength": 600 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "succeeded" } }, "required": ["status"] },
      "then": {
        "properties": {
          "requested_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "observed_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "finished_at_utc": { "type": "string", "format": "date-time" },
          "readiness": { "type": "object" }
        }
      }
    }
  ]
}
