{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dhe-cruzer69/x4-fleet/data/evidence/schema.json",
  "title": "X4 Evidence Entry",
  "type": "object",
  "required": ["id", "state", "claim", "observed_at", "source"],
  "properties": {
    "id": { "type": "string", "description": "Stable evidence id" },
    "state": {
      "type": "string",
      "enum": ["OBSERVED", "CORRELATED", "HYPOTHESIS", "VALIDATED", "UNKNOWN", "FAIL"]
    },
    "claim": { "type": "string" },
    "observed_at": { "type": "string", "format": "date-time" },
    "source": { "type": "string" },
    "repo": { "type": "string" },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "string" }
  }
}
